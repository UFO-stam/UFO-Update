<!-- Hero Section -->
{% if type == "post" %}
    <section class="relative overflow-hidden bg-gradient-to-br from-blue to-blue-dark text-white">
{% elseif type == "nieuwsbrief" %}
    <section class="relative overflow-hidden bg-gradient-to-br from-burgundy to-burgundy-dark text-white">
{% else %}
    <section class="relative overflow-hidden bg-gradient-to-br from-gray-800 to-black text-white">
{% endif %}
	<div class="absolute inset-0 bg-black opacity-20"></div>
	<div class="relative max-w-6xl mx-auto px-4 py-24">
		<div class="text-center">
			<div
				class="inline-block bg-white text-burgundy-dark bg-opacity-20 px-4 py-2 rounded-full text-sm font-medium mb-6 floating-element">
				{% if type == "nieuwsbrief" %}Maandelijkse Nieuwsbrief{% else %}Artikel{% endif %}
			</div>
			<h1 class="font-display text-5xl md:text-7xl font-bold mb-6 leading-tight">
				{{ title }}
			</h1>
			<p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto opacity-90">
				{{ description }}
			</p>
			<div class="flex items-center justify-center space-x-6 text-sm">
				<span class="flex items-center">
					<svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
						<path
							d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" />
					</svg>
					{{ content | timeToRead }} min leestijd
				</span>
				<span class="flex items-center">
					<svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
						<path
							d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zM4 7h12v9a1 1 0 01-1 1H5a1 1 0 01-1-1V7z" />
					</svg>
					<time> 
						{{ date | postDate }}
					</time>
				</span>
			</div>
		</div>
	</div>
	<div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-base-100 to-transparent"></div>
</section>