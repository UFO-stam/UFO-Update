<style>
	#jumpscare {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		z-index: 9999;
		background: black;
		justify-content: center;
		align-items: center;
	}

	#jumpscare img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.fade-in {
		animation: fadeIn 0.1s;
	}

	#consentModal {
		opacity: 1;
		animation-name: fadeIn;
		animation-iteration-count: 1;
		animation-timing-function: ease-in;
		animation-duration: 1s;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}
</style>

<!-- Consent Modal -->
<div id="consentModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
	<div class="bg-white rounded-lg shadow-2xl p-8 max-w-md mx-4">
		<h2 class="text-2xl font-bold text-gray-800 mb-4">⚠️ Waarschuwing</h2>
		<p class="text-gray-600 mb-6">
			Deze maandelijkse editie bevat schokkende, verontrustende en/of enge interactieve inhoud.
		</p>
		<p class="text-sm text-gray-500 mb-6">
			Geef je consent om gespookt te worden?
		</p>
		<div class="flex gap-4">
			<button id="acceptBtn" class="flex-1 btn btn-primary">
				Ja, ik ben dapper! 👻
			</button>
			<button id="declineBtn" class="flex-1 btn">
				Nee dankje
			</button>
		</div>
	</div>
</div>

<!-- Jump Scare Element -->
<div id="jumpscare">
	<img src="/uploads/RTK2.jpg" alt="Enge Robbe">
</div>
<div id="scarePoint"></div>


<script>
	let consented = false;
	let scareTriggered = false;

	const modal = document.getElementById('consentModal');
	const acceptBtn = document.getElementById('acceptBtn');
	const declineBtn = document.getElementById('declineBtn');
	const jumpscare = document.getElementById('jumpscare');

	// Create audio element for the scream sound
	const scareAudio = new Audio('/uploads/kaching.mp3');
	scareAudio.volume = 1;
	scareAudio.preload = 'auto';

	function playScream() {
		scareAudio.currentTime = 0;
		scareAudio.play().catch(e => console.log('Audio play failed:', e));
	}

	acceptBtn.addEventListener('click', () => {
		consented = true;
		modal.style.display = 'none';
		scareAudio.load();
	});

	declineBtn.addEventListener('click', () => {
		modal.style.display = 'none';
	});

	// Use Intersection Observer to detect when the trigger div is visible
	const scarePoint = document.getElementById('scarePoint');

	const observer = new IntersectionObserver((entries) => {
		if (!consented || scareTriggered) return;

		entries.forEach(entry => {
			if (entry.isIntersecting) {
				scareTriggered = true;
				triggerJumpscare();
			}
		});
	}, {
		threshold: 0.5 // Trigger when 50% of the div is visible
	});

	observer.observe(scarePoint);

	function triggerJumpscare() {
		jumpscare.style.display = 'flex';
		jumpscare.classList.add('fade-in');
		playScream();

		// Hide after 0.8 seconds
		setTimeout(() => {
			jumpscare.style.display = 'none';
		}, 800);
	}
</script>