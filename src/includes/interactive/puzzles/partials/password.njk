<div class="space-y-4 max-w-lg mx-auto">

    <div class="bg-base-200 p-4 sm:p-6 rounded-lg border-l-4 border-blue-500">
        <label class="block text-sm sm:text-base font-semibold text-blue-600 mb-3">
            🔒 Voer het antwoord in
        </label>
        <input type="text" id="password-input" placeholder="Typ hier je antwoord..."
            class="w-full px-4 py-3 text-base sm:text-lg bg-base-100 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none transition-colors" />
    </div>

    <div class="flex justify-center">
        <button onclick="checkPassword()"
            class="px-6 sm:px-8 py-2.5 sm:py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-full text-sm sm:text-base font-medium transition-all hover:shadow-lg">
            Controleer
        </button>
    </div>

    <div id="password-status" class="text-center text-sm sm:text-base font-medium min-h-[40px]"></div>

</div>


<script>
    const SECRET_PASSWORD = {{ password | dump | safe }}.toUpperCase();
	const EDITIE = {{ editie | dump | safe }};

    function checkPassword() {
        const input = document.getElementById('password-input');
        const status = document.getElementById('password-status');
        const userPassword = input.value.toUpperCase().trim();

        if (userPassword === SECRET_PASSWORD) {
            // Succes
            status.className = 'text-center text-sm sm:text-base font-medium text-green-200 bg-green-900 rounded-lg p-3 transition-all';
            status.textContent = '🎉 Correct! Goed gedaan!';

            if (typeof umami !== 'undefined') {
                umami.track(EDITIE, {status: 'success'});
            }
        } else if (userPassword === '') {
            // Leeg
            status.className = 'text-center text-sm sm:text-base font-medium text-yellow-400 transition-all';
            status.textContent = 'Voer eerst iets in...';
        } else {
            // Fout
            status.className = 'text-center text-sm sm:text-base font-medium text-red-200 bg-red-900 rounded-lg p-3 transition-all';
            status.textContent = '❌ Onjuist. Probeer het nog eens!';
            
            if (typeof umami !== 'undefined') {
                umami.track(EDITIE, {status: 'failed'});
            }

            // Shake animatie
            input.classList.add('shake');
            setTimeout(() => input.classList.remove('shake'), 500);
        }
    }

    // Enter toets ondersteuning
    document.getElementById('password-input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            checkPassword();
        }
    });

    // CSS voor de fout-animatie
    const style = document.createElement('style');
    style.textContent = `
        .shake { animation: shake 0.5s; }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
    `;
    document.head.appendChild(style);
</script>