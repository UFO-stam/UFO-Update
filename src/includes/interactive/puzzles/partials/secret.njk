<!-- Secret Password Field -->
<div class="space-y-4 max-w-lg mx-auto">

	<!-- Password Input -->
	<div class="bg-base-200 p-4 sm:p-6 rounded-lg border-l-4 border-blue-500">
		<label class="block text-sm sm:text-base font-semibold text-blue-600 mb-3">
			🔒 Geheim Wachtwoord
		</label>
		<input type="password" id="password-input" placeholder="Voer wachtwoord in..."
			class="w-full px-4 py-3 text-base sm:text-lg bg-base-100 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none transition-colors" />
	</div>

	<!-- Submit Button -->
	<div class="flex justify-center">
		<button onclick="checkPassword()"
			class="px-6 sm:px-8 py-2.5 sm:py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-full text-sm sm:text-base font-medium transition-all hover:shadow-lg">
			Controleer
		</button>
	</div>


	<!-- Status Message -->
	<div id="password-status" class="text-center text-sm sm:text-base font-medium"></div>

</div>

<script>
	const PASSWORDS = {{ passwords | dump | safe }};
	const SECRET_PASSWORD = PASSWORDS[Math.floor(Math.random() * PASSWORDS.length)].password;

	// Hide password in page by making letters bold
	function hidePasswordInPage() {
		// Find all <p> elements inside .prose that have no additional classes
		const paragraphs = Array.from(document.querySelectorAll('.prose p')).filter(p => 
			p.className === '' || p.classList.length === 0
		);

		if (paragraphs.length === 0) return;

		const password = SECRET_PASSWORD.toUpperCase();
		let passwordIndex = 0;

		// Helper function to get text nodes and their positions
		function getTextNodesWithPositions(element) {
			const textNodes = [];
			const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
			
			let node;
			while (node = walker.nextNode()) {
				// Skip if already inside a <strong> or <b> tag
				let parent = node.parentNode;
				let isBold = false;
				while (parent && parent !== element) {
					if (parent.tagName === 'STRONG' || parent.tagName === 'B') {
						isBold = true;
						break;
					}
					parent = parent.parentNode;
				}
				
				if (!isBold && node.textContent.trim()) {
					textNodes.push(node);
				}
			}
			
			return textNodes;
		}

		// First pass: try to hide in order
		for (const p of paragraphs) {
			if (passwordIndex >= password.length) break;

			const textNodes = getTextNodesWithPositions(p);
			const targetLetter = password[passwordIndex];

			// Search through text nodes for the target letter
			for (const textNode of textNodes) {
				if (passwordIndex >= password.length) break;
				
				const text = textNode.textContent;
				const index = text.toUpperCase().indexOf(targetLetter);
				
				if (index !== -1) {
					// Split the text node and wrap the letter in <strong>
					const before = text.substring(0, index);
					const letter = text[index];
					const after = text.substring(index + 1);
					
					const beforeNode = document.createTextNode(before);
					const strongNode = document.createElement('strong');
					strongNode.textContent = letter;
					const afterNode = document.createTextNode(after);
					
					const parent = textNode.parentNode;
					parent.insertBefore(beforeNode, textNode);
					parent.insertBefore(strongNode, textNode);
					parent.insertBefore(afterNode, textNode);
					parent.removeChild(textNode);
					
					passwordIndex++;
					break;
				}
			}
		}

		// Second pass: if we couldn't fit all letters in order, use flexible placement
		if (passwordIndex < password.length) {
			console.log('Could not fit password in order, using flexible placement');
			
			for (const p of paragraphs) {
				if (passwordIndex >= password.length) break;

				const textNodes = getTextNodesWithPositions(p);

				for (const textNode of textNodes) {
					if (passwordIndex >= password.length) break;
					
					const text = textNode.textContent;
					const targetLetter = password[passwordIndex];
					const index = text.toUpperCase().indexOf(targetLetter);
					
					if (index !== -1) {
						const before = text.substring(0, index);
						const letter = text[index];
						const after = text.substring(index + 1);
						
						const beforeNode = document.createTextNode(before);
						const strongNode = document.createElement('strong');
						strongNode.textContent = letter;
						const afterNode = document.createTextNode(after);
						
						const parent = textNode.parentNode;
						parent.insertBefore(beforeNode, textNode);
						parent.insertBefore(strongNode, textNode);
						parent.insertBefore(afterNode, textNode);
						parent.removeChild(textNode);
						
						passwordIndex++;
						break;
					}
				}
			}
		}
	}

	// Run on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', hidePasswordInPage);
	} else {
		hidePasswordInPage();
	}

	function checkPassword() {
		const input = document.getElementById('password-input');
		const status = document.getElementById('password-status');
		const userPassword = input.value.toUpperCase().trim();

		if (userPassword === SECRET_PASSWORD) {
			status.className = 'text-center text-sm sm:text-base font-medium text-green-200 bg-green-900 rounded-lg p-3 transition-all';
			status.textContent = '🎉 Correct! Jij bent een echte speurneus!';

			// Optional: Track success
			if (typeof umami !== 'undefined') {
				umami.track('Secret Password Success');
			}
		} else if (userPassword === '') {
			status.className = 'text-center text-sm sm:text-base font-medium text-yellow-400 transition-all';
			status.textContent = 'Voer een wachtwoord in';
		} else {
			status.className = 'text-center text-sm sm:text-base font-medium text-red-200 bg-red-900 rounded-lg p-3 transition-all';
			status.textContent = '❌ Onjuiste code. Probeer opnieuw!';
			umami.track('Secret Password Success');

			// Shake animation on wrong password
			input.classList.add('shake');
			setTimeout(() => input.classList.remove('shake'), 500);
		}
	}

	// Allow Enter key to submit
	document.getElementById('password-input').addEventListener('keypress', (e) => {
		if (e.key === 'Enter') {
			checkPassword();
		}
	});

	// Add shake animation
	const style = document.createElement('style');
	style.textContent = `
		.shake {
			animation: shake 0.5s;
		}
		@keyframes shake {
			0%, 100% { transform: translateX(0); }
			25% { transform: translateX(-10px); }
			75% { transform: translateX(10px); }
		}
	`;
	document.head.appendChild(style);
</script>