<!-- Game Area -->
<div class="space-y-6">
	<!-- Status -->
	<div id="status" class="text-center text-xl sm:text-2xl font-bold text-black dark:text-white min-h-[2rem]">
		Jouw beurt! (X)
	</div>

	<!-- Game Board Container -->
	<div class="flex justify-center items-center relative">
		<!-- Empty Cell -->
		<div class="w-16 h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24"></div>

		<!-- Main Grid (centered) -->
		<div id="grid"
			class="inline-grid grid-cols-3 gap-2 sm:gap-3 bg-gray-200 dark:bg-gray-800 p-4 sm:p-6 rounded-lg"></div>

		<!-- Secret Win Cell -->
		<div id="secret-cell" class="w-16 h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24
				bg-gray-100 dark:bg-gray-800 rounded-lg border-2 border-gray-200 dark:border-gray-700
				flex items-center justify-center text-5xl sm:text-6xl font-bold cursor-pointer transition-all
				opacity-0" title=""></div>
	</div>

	<!-- Controls -->
	<div class="flex justify-center">
		<button onclick="resetGame()"
			class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-full font-medium transition-all hover:shadow-lg">
			Nieuw Spel
		</button>
	</div>
</div>


<script>
	let board = Array(9).fill(null);
	let gameOver = false;
	let playerMoves = 0;

	const winPatterns = [
		[0, 1, 2], [3, 4, 5], [6, 7, 8], // rows
		[0, 3, 6], [1, 4, 7], [2, 5, 8], // columns
		[0, 4, 8], [2, 4, 6]              // diagonals
	];

	function initGame() {
		board = Array(9).fill(null);
		gameOver = false;
		playerMoves = 0;
		renderBoard();
		updateStatus('Jouw beurt! (X)');
		document.getElementById('secret-cell').textContent = '';
		document.getElementById('secret-cell').classList.remove('bg-gray-800', 'text-red-600', 'scale-110', 'opacity-100', 'border-gray-700');
		document.getElementById('secret-cell').classList.add('opacity-0', 'bg-gray-900', 'border-gray-900');
	}

	function renderBoard() {
		const grid = document.getElementById('grid');
		grid.innerHTML = '';

		for (let i = 0; i < 9; i++) {
			const cell = document.createElement('div');
			cell.className = 'w-16 h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24 bg-white rounded-lg flex items-center justify-center text-5xl sm:text-6xl font-bold cursor-pointer hover:bg-gray-100 transition-all';
			cell.dataset.index = i;
			cell.textContent = board[i] || '';

			if (board[i] === 'X') {
				cell.classList.add('text-red-600');
			} else if (board[i] === 'O') {
				cell.classList.add('text-blue-600');
			}

			if (board[i] || gameOver) {
				cell.classList.remove('cursor-pointer', 'hover:bg-gray-100');
				cell.classList.add('cursor-not-allowed');
			}

			cell.addEventListener('click', () => handleCellClick(i));
			grid.appendChild(cell);
		}
	}

	function handleCellClick(index) {
		if (gameOver || board[index]) return;

		board[index] = 'X';
		playerMoves++;
		renderBoard();

		if (checkWin('X')) {
			endGame('Je hebt gewonnen... maar wacht eens!', false);
			setTimeout(() => {
				updateStatus('Oeps! Dat was eigenlijk geen geldige overwinning 😅');
			}, 1500);
			return;
		}

		if (board.every(cell => cell !== null)) {
			endGame('Gelijkspel!', false);
			umami.track('November 2025 tictactoe Gelijkspel');
			return;
		}

		setTimeout(() => {
			aiMove();
		}, 300);
	}

	function aiMove() {
		if (gameOver) return;

		// Perfect AI - always blocks or wins
		let move = findWinningMove('O');
		if (move === -1) move = findWinningMove('X');
		if (move === -1) move = findBestMove();

		board[move] = 'O';
		renderBoard();

		if (checkWin('O')) {
			endGame('AI wint! Probeer het opnieuw...', false);
			umami.track('November 2025 tictactoe verloren van AI');
			return;
		}

		if (board.every(cell => cell !== null)) {
			endGame('Gelijkspel!', false);
			return;
		}

		updateStatus('Jouw beurt! (X)');
	}

	function findWinningMove(player) {
		for (let i = 0; i < 9; i++) {
			if (board[i]) continue;
			board[i] = player;
			const wins = checkWin(player);
			board[i] = null;
			if (wins) return i;
		}
		return -1;
	}

	function findBestMove() {
		const AI = 'O';
		const HUMAN = 'X';

		// Terminal helpers
		function checkWinner(b) {
			for (let p of winPatterns) {
				if (p.every(i => b[i] === 'O')) return 'O';
				if (p.every(i => b[i] === 'X')) return 'X';
			}
			if (b.every(v => v !== null)) return 'draw';
			return null;
		}

		function score(winner) {
			if (winner === AI) return 1;
			if (winner === HUMAN) return -1;
			return 0; // draw
		}

		// Move ordering preference (tie-breaker)
		const preferredOrder = [4, 0, 2, 6, 8, 1, 3, 5, 7];

		// Minimax with alpha-beta
		function minimax(b, player, alpha, beta) {
			const winner = checkWinner(b);
			if (winner !== null) {
				return score(winner);
			}

			const empties = [];
			for (let i = 0; i < 9; i++) if (b[i] === null) empties.push(i);

			if (player === AI) {
				let maxEval = -Infinity;
				// order moves using preference to speed tie resolution
				empties.sort((a, c) => preferredOrder.indexOf(a) - preferredOrder.indexOf(c));
				for (let i of empties) {
					b[i] = AI;
					let eval = minimax(b, HUMAN, alpha, beta);
					b[i] = null;
					if (eval > maxEval) maxEval = eval;
					alpha = Math.max(alpha, eval);
					if (beta <= alpha) break;
				}
				return maxEval;
			} else {
				let minEval = Infinity;
				empties.sort((a, c) => preferredOrder.indexOf(a) - preferredOrder.indexOf(c));
				for (let i of empties) {
					b[i] = HUMAN;
					let eval = minimax(b, AI, alpha, beta);
					b[i] = null;
					if (eval < minEval) minEval = eval;
					beta = Math.min(beta, eval);
					if (beta <= alpha) break;
				}
				return minEval;
			}
		}

		// Choose best move
		const empties = board.map((v, i) => v === null ? i : null).filter(v => v !== null);
		// If immediate win or block is available, keep that short-circuit (fast)
		for (let i of empties) {
			// win
			let t = [...board]; t[i] = AI;
			if (checkWinner(t) === AI) return i;
		}
		for (let i of empties) {
			// block
			let t = [...board]; t[i] = HUMAN;
			if (checkWinner(t) === HUMAN) return i;
		}

		// Otherwise use minimax to choose the move
		let bestScore = -Infinity;
		let bestMove = null;

		// iterate empties in preferred order for deterministic results
		const ordered = empties.slice().sort((a, b) => preferredOrder.indexOf(a) - preferredOrder.indexOf(b));
		for (let i of ordered) {
			board[i] = AI;
			let moveScore = minimax(board, HUMAN, -Infinity, Infinity);
			board[i] = null;
			if (moveScore > bestScore) {
				bestScore = moveScore;
				bestMove = i;
				// perfect win early exit
				if (bestScore === 1) break;
			}
		}

		// fallback
		return bestMove !== null ? bestMove : empties[0];
	}

	function checkWin(player) {
		return winPatterns.some(pattern =>
			pattern.every(index => board[index] === player)
		);
	}

	function updateStatus(message) {
		document.getElementById('status').textContent = message;
	}

	function endGame(message, isWin) {
		gameOver = true;
		updateStatus(message);
		if (isWin) {
			confetti();
		}
	}

	// Secret win cell handler
	document.getElementById('secret-cell').addEventListener('click', () => {
		if (gameOver) return;

		// Check if positions 3 and 4 (middle row, right two cells) both have X
		// Position 3 = middle row left, Position 4 = middle row center, Position 5 = middle row right
		// We want positions 4 and 5 (center and right of middle row)
		if (board[4] === 'X' && board[5] === 'X') {
			const secretCell = document.getElementById('secret-cell');
			secretCell.textContent = 'X';
			secretCell.classList.remove('opacity-0', 'bg-gray-900', 'border-gray-900');
			secretCell.classList.add('text-red-600', 'opacity-100');
			gameOver = true;

			setTimeout(() => {
				updateStatus('Zeer goed gespeeld! Je hebt gewonnen! 🎉');
				confetti();
				umami.track('November 2025 tictactoe Gewonnen');
			}, 300);
		}
	});

	function confetti() {
		// Simple confetti effect
		const colors = ['#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6'];
		for (let i = 0; i < 50; i++) {
			setTimeout(() => {
				const confetti = document.createElement('div');
				confetti.style.cssText = `
                        position: fixed;
                        width: 10px;
                        height: 10px;
                        background: ${colors[Math.floor(Math.random() * colors.length)]};
                        left: ${Math.random() * 100}%;
                        top: -10px;
                        opacity: 1;
                        transform: rotate(${Math.random() * 360}deg);
                        pointer-events: none;
                        z-index: 9999;
                    `;
				document.body.appendChild(confetti);

				const animation = confetti.animate([
					{ transform: `translateY(0) rotate(0deg)`, opacity: 1 },
					{ transform: `translateY(${window.innerHeight + 20}px) rotate(${Math.random() * 720}deg)`, opacity: 0 }
				], {
					duration: 2000 + Math.random() * 1000,
					easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
				});

				animation.onfinish = () => confetti.remove();
			}, i * 30);
		}
	}

	function resetGame() {
		initGame();
	}

	// Initialize game
	initGame();
</script>