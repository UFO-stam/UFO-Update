<style>
	html {
		scroll-behavior: smooth;
	}

	.nav-item {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.nav-item:hover {
		transform: translateX(4px);
	}

	@keyframes slideIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.slide-in {
		animation: slideIn 0.3s ease-out;
	}

	@keyframes sparkle {

		0%,
		100% {
			transform: rotate(0deg);
		}

		50% {
			transform: rotate(5deg);
		}
	}

	.sparkle {
		animation: sparkle 2s ease-in-out infinite;
	}
</style>
<script>
	// ============================================
	// Configuration
	// ============================================
	const CONFIG = {
		selectors: {
			h2: '.prose h2',
			navContainerId: 'h2-nav-container',
			navToggleId: 'h2-nav-toggle',
			navMenuId: 'h2-nav-menu',
			navListId: 'h2-nav-list'
		},
		classes: {
			navItem: 'nav-item',
			activeItem: ['bg-indigo-100', 'text-indigo-700', 'font-semibold'],
			navLink: 'block px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-lg cursor-pointer transition-colors duration-200'
		},
		observer: {
			rootMargin: '-20% 0px -70% 0px',
			threshold: 0
		}
	};

	// ============================================
	// DOM Creation Utilities
	// ============================================
	const DOMBuilder = {
		createElement(tag, attributes = {}, children = []) {
			const element = document.createElement(tag);

			Object.entries(attributes).forEach(([key, value]) => {
				if (key === 'className') {
					element.className = value;
				} else if (key === 'innerHTML') {
					element.innerHTML = value;
				} else {
					element.setAttribute(key, value);
				}
			});

			children.forEach(child => {
				if (typeof child === 'string') {
					element.appendChild(document.createTextNode(child));
				} else {
					element.appendChild(child);
				}
			});

			return element;
		},

		createToggleButton() {
			return this.createElement('button', {
				id: CONFIG.selectors.navToggleId,
				className: 'sparkle fixed bottom-6 right-6 z-50 bg-gradient-to-r from-indigo-600 to-indigo-500 text-white p-4 rounded-full shadow-2xl hover:shadow-indigo-500/50 transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-4 focus:ring-indigo-300',
				'aria-label': 'Toggle navigation menu',
				'aria-expanded': 'false',
				'aria-controls': CONFIG.selectors.navMenuId,
				innerHTML: `
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          `
			});
		},

		createNavMenu() {
			const menu = this.createElement('nav', {
				id: CONFIG.selectors.navMenuId,
				className: 'fixed bottom-24 right-6 z-40 bg-white rounded-xl shadow-2xl overflow-hidden transition-all duration-300 opacity-0 pointer-events-none max-w-xs w-72',
				role: 'navigation',
				'aria-label': 'Section navigation',
				style: 'transform: translateY(10px);'
			});

			const header = this.createElement('div', {
				className: 'bg-gradient-to-r from-blue-600 to-blue-500 px-4 py-3'
			}, [
				this.createElement('h2', {
					className: 'text-white font-semibold text-lg flex items-center gap-2'
				}, [
					'✨ Ga snel naar..'
				])
			]);

			const list = this.createElement('ul', {
				id: CONFIG.selectors.navListId,
				className: 'max-h-96 overflow-y-auto p-2',
				role: 'list'
			});

			menu.appendChild(header);
			menu.appendChild(list);

			return menu;
		},

		createNavItem(h2Element, index) {
			const id = h2Element.id || `section-${index}`;
			if (!h2Element.id) {
				h2Element.id = id;
			}

			const link = this.createElement('a', {
				href: `#${id}`,
				className: CONFIG.classes.navLink,
				role: 'button',
				tabindex: '0'
			}, [h2Element.textContent]);

			const listItem = this.createElement('li', {
				className: CONFIG.classes.navItem
			}, [link]);

			return { listItem, link, h2Element };
		}
	};

	// ============================================
	// Navigation Manager
	// ============================================
	class NavigationManager {
		constructor() {
			this.isMenuOpen = false;
			this.activeItem = null;
			this.elements = {};
			this.h2Elements = [];
			this.navItems = [];
		}

		init() {
			this.injectNavigation();
			this.collectH2Elements();
			this.createNavItems();
			this.attachEventListeners();
			this.setupIntersectionObserver();
		}

		injectNavigation() {
			const container = DOMBuilder.createElement('div', {
				id: CONFIG.selectors.navContainerId
			});

			const toggleButton = DOMBuilder.createToggleButton();
			const navMenu = DOMBuilder.createNavMenu();

			container.appendChild(toggleButton);
			container.appendChild(navMenu);
			document.body.appendChild(container);

			this.elements = {
				toggle: toggleButton,
				menu: navMenu,
				list: document.getElementById(CONFIG.selectors.navListId)
			};
		}

		collectH2Elements() {
			this.h2Elements = Array.from(document.querySelectorAll(CONFIG.selectors.h2));
		}

		createNavItems() {
			this.h2Elements.forEach((h2, index) => {
				const { listItem, link, h2Element } = DOMBuilder.createNavItem(h2, index);

				this.navItems.push({ link, h2Element });
				this.elements.list.appendChild(listItem);

				link.addEventListener('click', (e) => this.handleNavClick(e, h2Element, link));
				link.addEventListener('keydown', (e) => this.handleNavKeydown(e, h2Element, link));
			});
		}

		attachEventListeners() {
			this.elements.toggle.addEventListener('click', () => this.toggleMenu());

			document.addEventListener('click', (e) => this.handleOutsideClick(e));
			document.addEventListener('keydown', (e) => this.handleEscapeKey(e));
		}

		setupIntersectionObserver() {
			const observer = new IntersectionObserver(
				(entries) => this.handleIntersection(entries),
				CONFIG.observer
			);

			this.h2Elements.forEach(h2 => observer.observe(h2));
		}

		handleNavClick(e, h2Element, link) {
			e.preventDefault();
			this.scrollToSection(h2Element, link);
			this.closeMenu();
		}

		handleNavKeydown(e, h2Element, link) {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				this.scrollToSection(h2Element, link);
				this.closeMenu();
			}
		}

		scrollToSection(element, navLink) {
			element.scrollIntoView({
				behavior: 'smooth',
				block: 'start',
				inline: 'nearest'
			});

			this.updateActiveItem(navLink);
		}

		updateActiveItem(navLink) {
			if (this.activeItem) {
				this.activeItem.classList.remove(...CONFIG.classes.activeItem);
			}
			navLink.classList.add(...CONFIG.classes.activeItem);
			this.activeItem = navLink;
		}

		toggleMenu() {
			this.isMenuOpen ? this.closeMenu() : this.openMenu();
		}

		openMenu() {
			this.isMenuOpen = true;
			this.elements.menu.style.opacity = '1';
			this.elements.menu.style.transform = 'translateY(0)';
			this.elements.menu.style.pointerEvents = 'auto';
			this.elements.menu.classList.add('slide-in');
			this.elements.toggle.setAttribute('aria-expanded', 'true');
		}

		closeMenu() {
			this.isMenuOpen = false;
			this.elements.menu.style.opacity = '0';
			this.elements.menu.style.transform = 'translateY(10px)';
			this.elements.menu.style.pointerEvents = 'none';
			this.elements.toggle.setAttribute('aria-expanded', 'false');
		}

		handleOutsideClick(e) {
			if (this.isMenuOpen &&
				!this.elements.menu.contains(e.target) &&
				!this.elements.toggle.contains(e.target)) {
				this.closeMenu();
			}
		}

		handleEscapeKey(e) {
			if (e.key === 'Escape' && this.isMenuOpen) {
				this.closeMenu();
				this.elements.toggle.focus();
			}
		}

		handleIntersection(entries) {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const navItem = this.navItems.find(
						item => item.h2Element.id === entry.target.id
					);
					if (navItem) {
						this.updateActiveItem(navItem.link);
					}
				}
			});
		}
	}

	// ============================================
	// Initialize
	// ============================================
	document.addEventListener('DOMContentLoaded', () => {
		const nav = new NavigationManager();
		nav.init();
	});
</script>