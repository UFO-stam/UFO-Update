---
title: "U.F.O. Update"
description: "De gloednieuwe online nieuwsbrief van Studentenscouting U.F.O.-Stam"
layout: page.njk
---

<!-- Hero Section -->
<section class="pt-32 pb-20 px-4 relative overflow-hidden bg-gradient-to-br from-slate-50 to-blue-50">
	<div id="particles-container" class="absolute inset-0 pointer-events-none"></div>
	<div class="max-w-7xl mx-auto">
		<div class="grid lg:grid-cols-2 gap-12 items-center">
			<div class="flex flex-col justify-center space-y-6 hero-content">
				<div
					class="inline-block bg-red-100 text-red-700 px-4 py-2 rounded-full text-sm font-medium mb-6 badge-animate">
					🚀 Maandelijkse Nieuwsbrief
				</div>
				<h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight hero-title">
					Blijf op de hoogte met
					<span class="text-primary">U.F.O. Update</span>
				</h1>
				<p class="text-xl text-gray-600 mb-8 leading-relaxed hero-description">
					De officiële nieuwsbrief van de U.F.O.-Stam. Elke maand vol met verhalen, interviews, columns en
					activiteiten van onze vereniging.
				</p>

				{%- set latestNewsletter = null -%}

				{% for post in collections.posts | reverse %}
				{% if not latestNewsletter and post.data.type == "nieuwsbrief" %}
				{% set latestNewsletter = post %}
				{% endif %}
				{% endfor %}

				{% set newsletterUrl = latestNewsletter.url if latestNewsletter else "/posts/" %}
				<div class="flex flex-col sm:flex-row gap-4 hero-buttons">
					<a href="{{ newsletterUrl | url }}"
						class="bg-gradient-to-r from-red-700 to-purple-600 text-white px-8 py-4 rounded-full font-semibold hover:shadow-xl transition-all transform hover:scale-105 btn-primary">
						Laatste Editie Lezen
					</a>
					<a href="/contact"
						class="border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-full font-semibold hover:border-red-800 hover:text-red-800 transition-all btn-secondary">
						contact
					</a>
				</div>
			</div>

			<div class="relative newsletter-preview">
				<div
					class="bg-white rounded-2xl shadow-2xl overflow-hidden newsletter-card transform rotate-3 hover:rotate-0 transition-transform duration-500">
					<div class="bg-gradient-to-r from-red-700 to-purple-600 p-6 text-white">
						<div class="text-sm opacity-80 mb-2">Splinter nieuw!</div>
						<h3 class="text-2xl font-bold">De Nieuwsbrief</h3>
					</div>
					<div class="p-6">
						<div class="space-y-4">
							<div class="flex items-start space-x-3">
								<div
									class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center flex-shrink-0">
									<span class="text-indigo-600 font-bold">1</span>
								</div>
								<div>
									<h4 class="font-semibold text-gray-900">Artikelen</h4>
									<p class="text-sm text-gray-600">Elke maand weer onderwerpen die iets losmaken</p>
								</div>
							</div>
							<div class="flex items-start space-x-3">
								<div
									class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0">
									<span class="text-purple-600 font-bold">2</span>
								</div>
								<div>
									<h4 class="font-semibold text-gray-900">Puzzels</h4>
									<p class="text-sm text-gray-600">Compleet interactieve items</p>
								</div>
							</div>
							<div class="flex items-start space-x-3">
								<div
									class="w-8 h-8 bg-pink-100 rounded-lg flex items-center justify-center flex-shrink-0">
									<span class="text-pink-600 font-bold">3</span>
								</div>
								<div>
									<h4 class="font-semibold text-gray-900">Agenda</h4>
									<p class="text-sm text-gray-600">Elke maand weer een strakke planning van de komende
										activiteiten</p>
								</div>
							</div>
						</div>
						<a href="/posts/nieuwsbrief-november-2025"
							class="mt-6 inline-block text-primary font-semibold hover:underline">
							Lees Meer →
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Features Section -->
<section id="features" class="py-20 px-4 bg-white">
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16 features-header">
			<h2 class="text-4xl font-bold text-gray-900 mb-4">Wat maakt ons bijzonder?</h2>
			<p class="text-xl text-gray-600">Professionele journalistiek door leden, voor leden.</p>
		</div>

		<div class="grid md:grid-cols-3 gap-8 feature-cards">
			<div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl p-8 card-hover feature-card">
				<div
					class="w-16 h-16 bg-indigo-600 rounded-xl flex items-center justify-center text-white text-2xl mb-6">
					✍️
				</div>
				<h3 class="text-2xl font-bold text-gray-900 mb-4">Authentieke Verhalen</h3>
				<p class="text-gray-600">Interviews, columns en reportages geschreven door onze gepassioneerde
					redacteuren over het leven binnen de vereniging.</p>
			</div>

			<div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-8 card-hover feature-card">
				<div
					class="w-16 h-16 bg-purple-600 rounded-xl flex items-center justify-center text-white text-2xl mb-6">
					🎨
				</div>
				<h3 class="text-2xl font-bold text-gray-900 mb-4">Creatieve Content</h3>
				<p class="text-gray-600">Van puzzels en horoscopen tot spotprenten en illustraties - elke editie zit vol
					verrassende content.</p>
			</div>

			<div class="bg-gradient-to-br from-pink-50 to-orange-50 rounded-2xl p-8 card-hover feature-card">
				<div class="w-16 h-16 bg-pink-600 rounded-xl flex items-center justify-center text-white text-2xl mb-6">
					📅
				</div>
				<h3 class="text-2xl font-bold text-gray-900 mb-4">Maandelijks & Actueel</h3>
				<p class="text-gray-600">Elke maand een nieuwe editie met actuele updates, bestuursberichten en een
					agenda vol activiteiten.</p>
			</div>
		</div>
	</div>
</section>

<!-- CTA Section -->
<section class="py-20 px-4 bg-gradient-to-br from-slate-50 to-blue-50">
	<div class="max-w-4xl mx-auto text-center">
		<h2 class="text-4xl font-bold text-gray-900 mb-6">Mis nooit meer een editie</h2>
		<p class="text-xl text-gray-600 mb-8">Met onze app ben je altijd up to date.</p>
		{% include "interactive/appinstall.njk" %}
	</div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
<script>
	// Initialize Anime.js animations when DOM is loaded
	document.addEventListener('DOMContentLoaded', function () {

		// Hero title animation with letter reveal
		anime({
			targets: '.hero-title',
			opacity: [0, 1],
			translateY: [50, 0],
			duration: 1000,
			delay: 800,
			easing: 'easeOutExpo'
		});

		// Gradient text shimmer effect
		anime({
			targets: '.hero-gradient',
			scale: [0.95, 1.05, 1],
			duration: 2000,
			delay: 1200,
			easing: 'easeInOutQuad',
			loop: true,
			direction: 'alternate'
		});

		// Description fade in
		anime({
			targets: '.hero-description',
			opacity: [0, 1],
			translateY: [30, 0],
			duration: 800,
			delay: 1000,
			easing: 'easeOutQuad'
		});

		// Buttons pop in
		anime({
			targets: '.hero-buttons button',
			scale: [0, 1],
			opacity: [0, 1],
			duration: 600,
			delay: anime.stagger(100, { start: 1200 }),
			easing: 'easeOutBack'
		});

		// Newsletter card animation
		anime({
			targets: '.newsletter-card',
			rotateY: [90, 0],
			opacity: [0, 1],
			duration: 1200,
			delay: 1000,
			easing: 'easeOutExpo'
		});

		// Newsletter card floating effect
		anime({
			targets: '.newsletter-preview',
			translateY: [-10, 10],
			duration: 3000,
			loop: true,
			direction: 'alternate',
			easing: 'easeInOutSine'
		});

		// Feature cards scroll animation
		const observerOptions = {
			threshold: 0.2,
			rootMargin: '0px 0px -100px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					anime({
						targets: '.feature-card',
						translateY: [50, 0],
						opacity: [0, 1],
						scale: [0.9, 1],
						duration: 800,
						delay: anime.stagger(150),
						easing: 'easeOutElastic(1, .6)'
					});
					observer.unobserve(entry.target);
				}
			});
		}, observerOptions);

		const featuresSection = document.querySelector('#features');
		if (featuresSection) observer.observe(featuresSection);

		// Create floating particles
		const particlesContainer = document.getElementById('particles-container');
		const particleCount = 30;

		for (let i = 0; i < particleCount; i++) {
			const particle = document.createElement('div');
			particle.className = 'particle';

			const size = Math.random() * 8 + 4;
			const colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe'];
			const color = colors[Math.floor(Math.random() * colors.length)];

			particle.style.width = size + 'px';
			particle.style.height = size + 'px';
			particle.style.backgroundColor = color;
			particle.style.opacity = '0';
			particle.style.left = Math.random() * 100 + '%';
			particle.style.top = Math.random() * 100 + '%';

			particlesContainer.appendChild(particle);

			anime({
				targets: particle,
				translateY: [
					{ value: Math.random() * 100 - 50, duration: Math.random() * 3000 + 2000 },
					{ value: Math.random() * 100 - 50, duration: Math.random() * 3000 + 2000 }
				],
				translateX: [
					{ value: Math.random() * 100 - 50, duration: Math.random() * 3000 + 2000 },
					{ value: Math.random() * 100 - 50, duration: Math.random() * 3000 + 2000 }
				],
				opacity: [
					{ value: 0.6, duration: 1000 },
					{ value: 0, duration: 1000 }
				],
				scale: [
					{ value: 1.5, duration: Math.random() * 2000 + 1000 },
					{ value: 0.5, duration: Math.random() * 2000 + 1000 }
				],
				duration: 4000,
				delay: Math.random() * 2000,
				loop: true,
				easing: 'easeInOutSine'
			});
		}

		// Button hover animations
		document.querySelectorAll('.btn-primary, .btn-secondary').forEach(btn => {
			btn.addEventListener('mouseenter', () => {
				anime({
					targets: btn,
					scale: 1.05,
					duration: 300,
					easing: 'easeOutQuad'
				});
			});

			btn.addEventListener('mouseleave', () => {
				anime({
					targets: btn,
					scale: 1,
					duration: 300,
					easing: 'easeOutQuad'
				});
			});
		});

		// Card hover effects
		document.querySelectorAll('.feature-card').forEach(card => {
			card.addEventListener('mouseenter', () => {
				anime({
					targets: card,
					translateY: -10,
					scale: 1.02,
					duration: 300,
					easing: 'easeOutQuad'
				});
			});

			card.addEventListener('mouseleave', () => {
				anime({
					targets: card,
					translateY: 0,
					scale: 1,
					duration: 300,
					easing: 'easeOutQuad'
				});
			});
		});

	});
</script>
<style>
	body {
		font-family: 'Inter', sans-serif;
	}

	.particle {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	@keyframes float {

		0%,
		100% {
			transform: translateY(0px);
		}

		50% {
			transform: translateY(-20px);
		}
	}

	.float-animation {
		animation: float 6s ease-in-out infinite;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.fade-in-up {
		animation: fadeInUp 0.8s ease-out forwards;
	}

	.gradient-text {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.card-hover {
		transition: all 0.3s ease;
	}

	.card-hover:hover {
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
	}
</style>