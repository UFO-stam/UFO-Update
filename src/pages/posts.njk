---
layout: page.njk
title: Alle nieuwsbrieven en artikelen
pagination:
  data: collections.posts
  size: 14
  alias: posts
  reverse: true
---

<section class="max-w-7xl mx-auto px-4 py-16">
  <header class="mb-16 relative">
    <div class="absolute -left-4 top-0 w-1 h-full bg-primary rounded-full hidden md:block"></div>
    <h1 class="text-5xl font-black font-display tracking-tight mb-4 text-base-content">
      Archief <span class="text-primary">.</span>
    </h1>
    <p class="text-xl text-base-content/60 max-w-2xl">Onze reis door de tijd, van maandelijkse updates tot diepgaande verhalen.</p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
    {% for post in posts %}
      {% set isNewsletter = post.data.type == "nieuwsbrief" %}
      {% set themeClass = "primary" if isNewsletter else "info" %}
      
      <article class="group relative flex flex-col bg-base-100 rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2 shadow-[0_0_40px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_50px_rgba(0,20,50,0.15)] border border-base-200">
        
        <div class="p-8 pb-0">
          <div class="flex items-center justify-between mb-6">
            <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest border border-{{ themeClass }} text-{{ themeClass }}">
              {{ post.data.type or 'Post' }}
            </span>
            <time class="text-xs text-base-content/40 font-mono" datetime="{{ post.date.toISOString() }}">
              {{ post.date | postDate }}
            </time>
          </div>

          <h2 class="text-2xl font-bold leading-tight group-hover:text-{{ themeClass }} transition-colors duration-300 text-base-content">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>
          
          <p class="mt-4 text-base-content/70 text-sm leading-relaxed line-clamp-3">
            {{ post.data.description or post.templateContent | striptags | truncate(140) }}
          </p>
        </div>

        <div class="mt-auto pt-8">
          <a href="{{ post.url }}" class="relative flex items-center justify-end px-8 py-5 group/link overflow-hidden">
            <div class="absolute inset-0 translate-y-[101%] bg-{{ themeClass }} transition-transform duration-300 ease-out group-hover/link:translate-y-0"></div>
            
            <span class="relative z-10 text-xs font-bold uppercase tracking-[0.2em] text-{{ themeClass }} group-hover/link:text-{{ themeClass }}-content flex items-center gap-2 transition-all duration-300 group-hover/link:gap-4">
              Lees Volledig Verhaal
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        </div>
      </article>
    {% endfor %}
  </div>

  {% if pagination.pages.length > 1 %}
    <nav class="flex justify-center mt-20">
      <div class="flex items-center gap-2 p-2 bg-base-200/50 rounded-2xl backdrop-blur-sm border border-base-300">
        {% if pagination.href.previous %}
          <a href="{{ pagination.href.previous }}" class="btn btn-ghost btn-circle text-base-content">←</a>
        {% endif %}
        
        <span class="px-6 py-2 text-sm font-medium text-base-content">
          {{ pagination.pageNumber + 1 }} <span class="opacity-30 mx-2 text-base-content">/</span> {{ pagination.pages.length }}
        </span>

        {% if pagination.href.next %}
          <a href="{{ pagination.href.next }}" class="btn btn-ghost btn-circle text-base-content">→</a>
        {% endif %}
      </div>
    </nav>
  {% endif %}
</section>